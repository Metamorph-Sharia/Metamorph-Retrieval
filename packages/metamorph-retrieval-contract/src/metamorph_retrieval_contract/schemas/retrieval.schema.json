{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metamorph.local/schemas/retrieval-0.1.schema.json",
  "title": "Retrieval contract 0.1",
  "description": "What crosses between a retrieval provider, the gateway and an answering agent. Each shape is one of $defs.",
  "$defs": {
    "ref": {
      "type": "string",
      "description": "{namespace}:{id}[#{address}], e.g. doc:ojk:pojk:2024:40#pasal-5/ayat-1",
      "pattern": "^[a-z][a-z0-9_]*:[^\\s#]+(#[^\\s#]+)?$"
    },
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "date": {"type": "string", "format": "date"},
    "optional_date": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "optional_string": {"type": ["string", "null"]},
    "cursor": {"type": ["string", "null"], "description": "Pass it back for the next page; null when there is none"},
    "legal_force": {"enum": ["binding", "sharia", "explanatory", "none"]},
    "link_type": {
      "enum": ["legal_basis", "implements", "amends", "supersedes", "revokes", "partly_revokes", "adopts_fatwa",
               "changes_fatwa", "refers_to", "names"]
    },
    "qualifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "valid_from", "valid_to", "under_review", "provisional", "as_of"],
      "properties": {
        "status": {"$ref": "#/$defs/optional_string"},
        "valid_from": {"$ref": "#/$defs/optional_date"},
        "valid_to": {"$ref": "#/$defs/optional_date"},
        "under_review": {"type": "boolean"},
        "provisional": {"type": "boolean"},
        "as_of": {"$ref": "#/$defs/optional_date"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "index_version", "source_published_at"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "index_version": {"type": "string", "minLength": 1},
        "source_published_at": {"type": "string", "format": "date-time"}
      }
    },
    "text_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "wording", "pages"],
      "properties": {
        "type": {"const": "text"},
        "wording": {"type": "string"},
        "pages": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {"start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}
            }
          ]
        }
      }
    },
    "figures_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "frequency", "observations"],
      "properties": {
        "type": {"const": "figures"},
        "unit": {"$ref": "#/$defs/optional_string"},
        "frequency": {"enum": ["monthly", "quarterly", "semiannual", "annual"]},
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["period", "value", "provisional"],
            "properties": {
              "period": {"type": "string", "pattern": "^\\d{4}(-(\\d{2}|Q[1-4]|S[12]))?$"},
              "value": {"type": "number"},
              "provisional": {"type": "boolean"}
            }
          }
        }
      }
    },
    "record_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "fields"],
      "properties": {"type": {"const": "record"}, "fields": {"type": "object"}}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "citation", "title", "legal_force", "qualifiers", "published_on", "url", "body",
                   "provenance"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "kind": {"type": "string", "minLength": 1},
        "citation": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "legal_force": {"$ref": "#/$defs/legal_force"},
        "qualifiers": {"$ref": "#/$defs/qualifiers"},
        "published_on": {"$ref": "#/$defs/optional_date"},
        "url": {"$ref": "#/$defs/optional_string"},
        "body": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/text_body"},
            {"$ref": "#/$defs/figures_body"},
            {"$ref": "#/$defs/record_body"}
          ]
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "score", "matched_by", "evidence"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "score": {"type": "number", "description": "Comparable only within one provider and one call"},
        "matched_by": {
          "type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["semantic", "words"]}
        },
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "target", "effective_on", "confidence"],
      "properties": {
        "type": {"$ref": "#/$defs/link_type"},
        "source": {"$ref": "#/$defs/ref"},
        "target": {"$ref": "#/$defs/ref"},
        "effective_on": {"$ref": "#/$defs/optional_date"},
        "confidence": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]}
      }
    },
    "page_fields": {
      "required": ["items", "cursor", "empty_reason", "warnings"],
      "properties": {
        "cursor": {"$ref": "#/$defs/cursor"},
        "empty_reason": {"enum": ["no_match", "filters_exclude_all", null]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hit_page": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/page_fields"}],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/hit"}},
        "cursor": true, "empty_reason": true, "warnings": true
      },
      "additionalProperties": false
    },
    "evidence_page": {
      "type": "object",
      "description": "What an exact tool returns: its evidence, unranked, in the tool's own order",
      "allOf": [{"$ref": "#/$defs/page_fields"}],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "cursor": true, "empty_reason": true, "warnings": true
      },
      "additionalProperties": false
    },
    "link_page": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/page_fields"}],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "cursor": true, "empty_reason": true, "warnings": true
      },
      "additionalProperties": false
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 25, "default": 8},
    "search_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "description": "The question, in Indonesian or English"},
        "kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "issuers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "documents": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"},
          "description": "Search only within these whole documents"
        },
        "published_from": {"$ref": "#/$defs/optional_date"},
        "published_to": {"$ref": "#/$defs/optional_date"},
        "in_force_on": {"$ref": "#/$defs/optional_date"},
        "legal_force": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/legal_force"}},
        "sort": {"enum": ["relevance", "newest"], "default": "relevance"},
        "limit": {"$ref": "#/$defs/limit"},
        "cursor": {"$ref": "#/$defs/cursor"}
      }
    },
    "links_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {"enum": ["outgoing", "incoming", "both"], "default": "both"},
        "types": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/link_type"}},
        "limit": {"$ref": "#/$defs/limit"},
        "cursor": {"$ref": "#/$defs/cursor"}
      }
    },
    "tool_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "input_schema", "output_schema"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "input_schema": {"type": "object"},
        "output_schema": {"type": "object"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "contract_version", "namespaces", "kinds", "links", "tools", "index_version",
                   "data_as_of"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "pattern": "^retrieval-\\d+\\.\\d+$"},
        "namespaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/namespace"}},
        "kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "links": {"type": "boolean"},
        "tools": {"type": "array", "items": {"$ref": "#/$defs/tool_spec"}},
        "index_version": {"type": "string", "minLength": 1},
        "data_as_of": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "message"],
      "properties": {
        "error": {"enum": ["unknown_ref", "unknown_tool", "invalid_argument", "capability_missing",
                           "provider_unavailable"]},
        "message": {"type": "string"}
      }
    }
  }
}
